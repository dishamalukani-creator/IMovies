# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/imovies

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Initial Administrator Provisioning (used by npm run seed:admin)
ADMIN_USERNAME=imovies_admin
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=your_secure_admin_password_min_8_chars
